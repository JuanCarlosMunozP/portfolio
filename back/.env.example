NODE_ENV=development
PORT=3201

# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
# Bearer token required to read stored contact messages (GET /api/contact)
ADMIN_TOKEN=change-me-to-a-long-random-string

# Allowed browser origin for CORS
CORS_ORIGIN=http://localhost:5173
# Set to the number of proxy hops when running behind a reverse proxy (e.g. 1).
# TRUST_PROXY=1

# SMTP — leave blank to disable contact notification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where contact-form notifications are delivered (defaults to SMTP_USER).
CONTACT_TO=
